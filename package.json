{
  "name": "citepath",
  "version": "0.1.3",
  "mcpName": "io.github.arif-js/citepath",
  "description": "Self-hosted search over your documentation, with citations, for AI assistants and apps",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "documentation",
    "search",
    "retrieval",
    "rag",
    "citations",
    "sqlite",
    "fts5",
    "claude",
    "cursor",
    "self-hosted",
    "cli"
  ],
  "homepage": "https://github.com/arif-js/citepath#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arif-js/citepath.git"
  },
  "bugs": {
    "url": "https://github.com/arif-js/citepath/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "citepath": "dist/interfaces/cli/index.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/interfaces/cli/index.js',0o755)\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run test/unit test/integration",
    "test:e2e": "vitest run test/e2e",
    "bench": "vitest run test/perf",
    "eval:fixtures": "vitest run test/eval",
    "schema:update": "vitest run test/unit/config-schema.test.ts -u",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "prepack": "npm run build",
    "version": "node scripts/sync-server-json.mjs && git add server.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "cheerio": "^1.2.0",
    "ignore": "^7.0.12",
    "markdown-it": "^14.1.0",
    "picomatch": "^4.0.7",
    "robots-parser": "^3.0.1",
    "undici": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.0",
    "@types/picomatch": "^4.0.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
